{\f3\par}\pard\plain \s323\sl276\slmult1\sb0\sa140\sl276\slmult1\ql\ltrpar{
\u1050\'ca\u1072\'e0\u1090\'f2\u1077\'e5\u1075\'e3\u1086\'ee\u1088\'f0\u1110\'b3\u1111\'bf \u1092\'f4\u1086\'ee\u1090\'f2\u1086\'ee\u1075\'e3\u1088\'f0\u1072\'e0\u1092\'f4\u1110\'b3\u1081\'e9, \u1072\'e0\u1076\'e4\u1072\'e0\u1087\'ef\u1090\'f2\u1080\'e8\u1074\'e2\u1085\'ed\u1072\'e0 \u1075\'e3\u1072\'e0\u1083\'eb\u1077\'e5\u1088\'f0\u1077\'e5\u1103\'ff \u1090\'f2\u1072\'e0 \u1087\'ef\u1077\'e5\u1088\'f0\u1077\'e5\u1075\'e3\u1083\'eb\u1103\'ff\u1076\'e4 \u1079\'e7\u1086\'ee\u1073\'e1\u1088\'f0\u1072\'e0\u1078\'e6\u1077\'e5\u1085\'ed\u1100\'fc \u1091\'f3 \u1074\'e2\u1077\'e5\u1083\'eb\u1080\'e8\u1082\'ea\u1086\'ee\u1084\'ec\u1091\'f3 \u1092\'f4\u1086\'ee\u1088\'f0\u1084\'ec\u1072\'e0\u1090\'f2\u1110\'b3.}
{\f3\par}\pard\plain \s323\sl276\slmult1\sb0\sa140\sl276\slmult1\ql\ltrpar{
\u1045\'c5\u1090\'f2\u1072\'e0\u1087\'ef 3 \u8212\'97 \u1087\'ef\u1086\'ee\u1089\'f1\u1083\'eb\u1091\'f3\u1075\'e3\u1080\'e8 \u1081\'e9 \u1079\'e7\u1072\'e0\u1103\'ff\u1074\'e2\u1082\'ea\u1080\'e8}
{\f3\par}\pard\plain \s323\sl276\slmult1\sb0\sa140\sl276\slmult1\ql\ltrpar{
\u1062\'d6\u1110\'b3\u1085\'ed\u1080\'e8, \u1092\'f4\u1086\'ee\u1088\'f0\u1084\'ec\u1072\'e0 \u1079\'e7\u1072\'e0\u1087\'ef\u1080\'e8\u1089\'f1\u1091\'f3, \u1074\'e2\u1072\'e0\u1083\'eb\u1110\'b3\u1076\'e4\u1072\'e0\u1094\'f6\u1110\'b3\u1103\'ff \u1090\'f2\u1072\'e0 \u1087\'ef\u1110\'b3\u1076\'e4\u1082\'ea\u1083\'eb\u1102\'fe\u1095\'f7\u1077\'e5\u1085\'ed\u1085\'ed\u1103\'ff \u1085\'ed\u1072\'e0\u1076\'e4\u1089\'f1\u1080\'e8\u1083\'eb\u1072\'e0\u1085\'ed\u1085\'ed\u1103\'ff \u1079\'e7\u1072\'e0\u1103\'ff\u1074\'e2\u1086\'ee\u1082\'ea.}
{\f3\par}\pard\plain \s323\sl276\slmult1\sb0\sa140\sl276\slmult1\ql\ltrpar{
\u1045\'c5\u1090\'f2\u1072\'e0\u1087\'ef 4 \u8212\'97 \u1092\'f4\u1110\'b3\u1085\'ed\u1072\'e0\u1083\'eb\u1100\'fc\u1085\'ed\u1072\'e0 \u1087\'ef\u1077\'e5\u1088\'f0\u1077\'e5\u1074\'e2\u1110\'b3\u1088\'f0\u1082\'ea\u1072\'e0}
