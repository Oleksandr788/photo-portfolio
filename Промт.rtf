3. \u1071\'df\u1082\'ea \u1103\'ff \u1088\'f0\u1077\'e5\u1082\'ea\u1086\'ee\u1084\'ec\u1077\'e5\u1085\'ed\u1076\'e4\u1091\'f3\u1102\'fe \u1088\'f0\u1077\'e5\u1072\'e0\u1083\'eb\u1110\'b3\u1079\'e7\u1091\'f3\u1074\'e2\u1072\'e0\u1090\'f2\u1080\'e8 \u1094\'f6\u1077\'e5\u1081\'e9 \u1087\'ef\u1088\'f0\u1086\'ee\u1108\'ba\u1082\'ea\u1090\'f2}
\par \pard\plain \s323\sl276\slmult1\sb0\sa140\sl276\slmult1\ql\ltrpar{
\u1054\'ce\u1089\'f1\u1082\'ea\u1110\'b3\u1083\'eb\u1100\'fc\u1082\'ea\u1080\'e8 \u1090\'f2\u1080\'e8 \u1079\'e7\u1072\'e0\u1081\'e9\u1084\'ec\u1072\'e0\u1108\'ba\u1096\'f8\u1089\'f1\u1103\'ff frontend-\u1088\'f0\u1086\'ee\u1079\'e7\u1088\'f0\u1086\'ee\u1073\'e1\u1082\'ea\u1086\'ee\u1102\'fe, \u1103\'ff \u1073\'e1 \u1088\'f0\u1072\'e0\u1076\'e4\u1080\'e8\u1074\'e2 \u1087\'ef\u1086\'ee\u1095\'f7\u1072\'e0\u1090\'f2\u1080\'e8 \u1079\'e7 HTML, CSS \u1110\'b3 JavaScript, \u1097\'f9\u1086\'ee\u1073\'e1 \u1086\'ee\u1090\'f2\u1088\'f0\u1080\'e8\u1084\'ec\u1072\'e0\u1090\'f2\u1080\'e8 \u1089\'f1\u1072\'e0\u1081\'e9\u1090\'f2, \u1082\'ea\u1086\'ee\u1076\'e4 \u1103\'ff\u1082\'ea\u1086\'ee\u1075\'e3\u1086\'ee \u1084\'ec\u1086\'ee\u1078\'e6\u1085\'ed\u1072\'e0 \u1089\'f1\u1072\'e0\u1084\'ec\u1086\'ee\u1089\'f1\u1090\'f2\u1110\'b3\u1081\'e9\u1085\'ed\u1086\'ee \u1087\'ef\u1110\'b3\u1076\'e4\u1090\'f2\u1088\'f0\u1080\'e8\u1084\'ec\u1091\'f3\u1074\'e2\u1072\'e0\u1090\'f2\u1080\'e8 \u1081\'e9 \u1087\'ef\u1086\'ee\u1082\'ea\u1072\'e0\u1079\'e7\u1091\'f3\u1074\'e2\u1072\'e0\u1090\'f2\u1080\'e8 \u1091\'f3 \u1089\'f1\u1074\'e2\u1086\'ee\u1108\'ba\u1084\'ec\u1091\'f3 \u1087\'ef\u1086\'ee\u1088\'f0\u1090\'f2\u1092\'f4\u1086\'ee\u1083\'eb\u1110\'b3\u1086\'ee.}
{\f3\par}\pard\plain \s323\sl276\slmult1\sb0\sa140\sl276\slmult1\ql\ltrpar{
\u1045\'c5\u1090\'f2\u1072\'e0\u1087\'ef 1 \u8212\'97 \u1076\'e4\u1080\'e8\u1079\'e7\u1072\'e0\u1081\'e9\u1085\'ed \u1110\'b3 \u1075\'e3\u1086\'ee\u1083\'eb\u1086\'ee\u1074\'e2\u1085\'ed\u1072\'e0 \u1089\'f1\u1090\'f2\u1086\'ee\u1088\'f0\u1110\'b3\u1085\'ed\u1082\'ea\u1072\'e0}
{\f3\par}\pard\plain \s323\sl276\slmult1\sb0\sa140\sl276\slmult1\ql\ltrpar{
\u1053\'cd\u1072\'e0\u1074\'e2\u1110\'b3\u1075\'e3\u1072\'e0\u1094\'f6\u1110\'b3\u1103\'ff, \u1074\'e2\u1077\'e5\u1083\'eb\u1080\'e8\u1082\'ea\u1080\'e8\u1081\'e9 \u1073\'e1\u1072\'e0\u1085\'ed\u1077\'e5\u1088\'f0, \u1074\'e2\u1080\'e8\u1073\'e1\u1088\'f0\u1072\'e0\u1085\'ed\u1110\'b3 \u1088\'f0\u1086\'ee\u1073\'e1\u1086\'ee\u1090\'f2\u1080\'e8, \u1073\'e1\u1083\'eb\u1086\'ee\u1082\'ea \u1087\'ef\u1086\'ee\u1089\'f1\u1083\'eb\u1091\'f3\u1075\'e3 \u1110\'b3 \u1092\'f4\u1091\'f3\u1090\'f2\u1077\'e5\u1088\'f0.}
{\f3\par}\pard\plain \s323\sl276\slmult1\sb0\sa140\sl276\slmult1\ql\ltrpar{
